class Employee:
    def __init__(self, name, salary):
        self.name = name
        self.salary = salary

class Company:
    def __init__(self, name):
        self.name = name
        self.__employees = [] 
        
    def add_employee(self, employee):
        if isinstance(employee, Employee):
            self.__employees.append(employee)
            print(f"Karyawan {employee.name} berhasil ditambahkan.")
        else:
            raise ValueError("Input tidak valid! Objek harus berupa instance dari class Employee.")

    def __calculate_payroll(self):
        total_payroll = sum(emp.salary for emp in self.__employees)
        return total_payroll
        
    def display_payroll(self):
        total = self.__calculate_payroll()
        print(f"Total gaji (payroll) untuk {self.name}: Rp {total}")

my_company = Company("Tech Nusantara")

emp1 = Employee("Budi", 5000000)
emp2 = Employee("Siti", 6500000)

my_company.add_employee(emp1)
my_company.add_employee(emp2)

my_company.display_payroll()